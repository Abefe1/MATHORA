# Copy this file to .env.local and fill in real values.
# .env*.local is gitignored — never commit real keys.
#
# EXPO_PUBLIC_* vars are bundled into the client JS (same caveat as
# Next's NEXT_PUBLIC_* prefix) — only the Supabase ANON key belongs
# here, never the service-role key.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Without these two set, the app falls back to local mock data
# (see src/services/supabaseService.ts / dataService.ts).

# Push notifications (src/services/pushNotifications.ts) additionally
# need this project linked to an EAS project — run `eas init` (or
# `eas build:configure`), which stamps
# Constants.expoConfig.extra.eas.projectId into app.json for you.
# There's no env var to set here for that part.
