# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real keys.
#
# Both values below come from your Supabase project's
# Settings -> API page. NEXT_PUBLIC_* vars are bundled into the
# client-side JS, so only the ANON key belongs here — never the
# service-role key (that one must stay server-only, e.g. as a
# non-NEXT_PUBLIC_ env var read from a Route Handler / Server Action,
# and is never used in this app today).

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Without these two set, the app falls back to mockData.ts
# (see src/lib/supabase.ts) instead of talking to a live project.

# --- Server-only (never NEXT_PUBLIC_, never referenced from a
# Client Component) ---

# Settings -> API -> service_role key. Bypasses RLS. Used only by
# src/lib/supabase/admin.ts, imported only by the notification
# dispatcher route.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Shared secret the notification dispatch cron job must send as the
# x-notification-secret header when calling
# POST /api/notifications/dispatch. Generate any long random string.
NOTIFICATIONS_DISPATCH_SECRET=generate-a-long-random-secret

# Web Push (browser notifications). Generate a pair with:
#   npx web-push generate-vapid-keys
# The public key is intentionally NEXT_PUBLIC_ — it's sent to the
# browser's pushManager.subscribe() call. The private key must not be.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key

# Optional: raises Expo's push notification rate limit. Get one from
# https://expo.dev/accounts/[account]/settings/access-tokens
EXPO_ACCESS_TOKEN=
