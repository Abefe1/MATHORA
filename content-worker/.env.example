# Copy to .env and fill in.

# Supabase — service role key (bypasses RLS; this worker is the only
# thing that writes draft questions/worked_examples and advances
# content_uploads.status, by design — see mathora_schema_content_pipeline_patch.sql).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Shared secret mathora-web's /api/content/ingest route must send as
# the x-worker-secret header when triggering a job. Generate any long
# random string; must match on both sides.
WORKER_SHARED_SECRET=generate-a-long-random-secret

# LLM used for the generate step (structured JSON quiz/notes output),
# run AFTER parsing — never fed a raw PDF/image. OpenAI-compatible
# client, so this works with SiliconFlow, OpenRouter, or any other
# OpenAI-compatible provider by changing the base URL.
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_API_KEY=your-provider-api-key
LLM_MODEL=qwen/qwen2.5-72b-instruct

# Optional: a vision-capable model, used only as a fallback when
# Docling extracts a page that's mostly a diagram/graph it can't
# convert to text (see app/parser.py's should_use_vision_fallback).
# Leave blank to disable the fallback entirely.
VISION_LLM_MODEL=qwen/qwen2.5-vl-72b-instruct
